// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum role {
  USER
  ADMIN
}

enum plan {
  FREE
}

model Portfolio {
  id String @id @default(uuid())
  userId String
  name String
  createdAt DateTime @default(now())
  baseCurrency String

  @@unique([userId, name])
}


// Assets

enum assetType {
  STOCK
  CRYPTO
  ETF
}


model Asset {
  id String @id @default(uuid())
  ticker String
  name String
  type assetType
  currency String
  isin String?
  createdAt DateTime @default(now())
  prices AssetPrice[]
}

model AssetPrice {
  id String @id @default(uuid())
  assetId String
  asset Asset @relation(fields: [assetId], references: [id])
  timestamp DateTime
  open Float
  high Float
  low Float
  close Float
  volume Float
}

// Transactions